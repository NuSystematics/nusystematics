          }
      ]
    }
}

GENIEFSIReWeight_Multisigma_Tool_Config: {
    tool_type: "GENIEReWeight"

    instance_name: "SBN_v3"

    # Keep one GENIEReWeight instance per discrete dial tweak in memory
    # Requires no reconfigures within the event loop
    UseFullHERG: true

    ignore_parameter_dependence: true

    FrG4_N_central_value: 0
    FrG4_N_variation_descriptor: "[+1,-1,+2,-2,+3,-3]"
    FrINCL_N_central_value: 0
    FrINCL_N_variation_descriptor: "[+1,-1,+2,-2,+3,-3]"

    FrG4LoE_N_central_value: 0
    FrG4LoE_N_variation_descriptor: "[+1,-1,+2,-2,+3,-3]"
    FrINCLLoE_N_central_value: 0
    FrINCLLoE_N_variation_descriptor: "[+1,-1,+2,-2,+3,-3]"

    FrG4M1E_N_central_value: 0
    FrG4M1E_N_variation_descriptor: "[+1,-1,+2,-2,+3,-3]"
    FrINCLM1E_N_central_value: 0
    FrINCLM1E_N_variation_descriptor: "[+1,-1,+2,-2,+3,-3]"

    FrG4M2E_N_central_value: 0
    FrG4M2E_N_variation_descriptor: "[+1,-1,+2,-2,+3,-3]"
    FrINCLM2E_N_central_value: 0
    FrINCLM2E_N_variation_descriptor: "[+1,-1,+2,-2,+3,-3]"

    FrG4HiE_N_central_value: 0
