    FrKin_PiProFix_N_central_value: 0
    FrKin_PiProFix_N_variation_descriptor: "[+1,-1,+2,-2,+3,-3]"

    FrKin_PiProBias_N_central_value: 0
    FrKin_PiProBias_N_variation_descriptor: "[+1,-1,+2,-2,+3,-3]"

    MFPLoE_N_central_value: 0
    MFPLoE_N_variation_descriptor: "[+1,-1,+2,-2,+3,-3]"
    MFPM1E_N_central_value: 0
