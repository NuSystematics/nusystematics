# Generic BDT reweighter (tool_type: BDTReweighter)
#
# Applies BDT models trained and exported to json with the python module
# BDTReweight (json_reweighter.export_reweighter_json).
#
# dial_name: name of the dial (default: BDTReweight); must be unique when the
#   tool is used more than once. Dial value 0 = CV (unit weight),
#   1 = fully reweighted; response = 1 + dial * (weight - 1).
# reweighters: list of BDT models. For each event, the first model whose
#   selection passes is used; events passing no selection get unit weight.
#   json_path:    exported BDT model
#   variables:    input variables, in the same order and units as in the
#                 training; names from nusyst::evvar
#                 (src/nusystematics/utility/GENIEEventVariables.hh)
#   selection:    list of cuts "<variable> <op> <value>", op in ==, !=, <, <=, >, >=;
#                 all must pass
#   scale_factor: normalization applied to the BDT weight (default 1)
#   weight_min/weight_max: clip the BDT weight before scale_factor (optional)
#
# CC1pi+ (NEUT mode 11) numu-Ar40 RES reweighting from GENIE AR23_20i_00_000
# Berger-Sehgal to NEUT 6.2.1 DCC (Eb = 10 MeV); BDT trained in
# /vol/work/261002_BDTReweight_RES/TrainRES.ipynb on flat-flux samples with
# 0.32 <= Enu < 10 GeV, so the selection is restricted to that range.
# Inputs are the NUISANCE GenericFlux_Tester variables Enu_true, Q2_true,
# W_nuc_rest, CosThAdler and PhiAdler (pre-FSI, PhiAdler in [-180, 180]).
# scale_factor is RWSF_from_Training, sum(target) / sum(source * BDT weight)
# over the training sample, with unclipped BDT weights.

BDTReweighter_RES_BS_to_DCC_ToolConfig: {

  tool_type: "BDTReweighter"
  instance_name: "RES_BS_to_DCC"

  dial_name: "RES_BS_to_DCC"
  RES_BS_to_DCC_variation_descriptor: "[0.0, 1.0]"

  reweighters: [
    {
      name: "RES_BS_to_DCC"
      # TODO Store the file in nusyst_data
      json_path: "/pnfs/icarus/persistent/users/jskim/Generators/NEUT/6.2.1/BDTTraining/FlatFlux_WithEmiss10MeV_numu_Ar40_NEUT_RS_to_NEUT_DCC_bdtreweighter.json"
      variables: [ "Enu", "Q2", "W_nuc_rest", "preFSI_CosThAdler", "preFSI_PhiAdler" ]
      selection: [ "IsCC == 1", "ProbePDG == 14", "NeutMode == 11", "Enu >= 0.32", "Enu < 10" ]
      scale_factor: 1.2551300648763175
    }
  ]

}

syst_providers: [
  BDTReweighter_RES_BS_to_DCC_ToolConfig
]
