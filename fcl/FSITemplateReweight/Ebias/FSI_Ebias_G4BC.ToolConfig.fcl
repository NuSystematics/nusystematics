FSI_Ebias_G4BC_Tool_Config: {

    tool_type: "FSIReweight"
    instance_name: "FSI_Ebias_Geant4"

    # Single dial driving the FSI 2D-map reweight.
    FSIReweight_central_value: 0
    FSIReweight_variation_descriptor: "[-3,-2,-1,0,1,2,3]"

    # Histogram manifest. FSIReweightCalculator expects a flat inputs array
    # whose entries each carry a `name:` key matching one of the calculator's
    # known histogram slots (hist_nom_protonPlus / hist_alt_protonPlus /
    # hist_nom_neutron / hist_alt_neutron / hist_nom_pion[Plus|0|Minus] /
    # hist_alt_pion[Plus|0|Minus]). At least one of nom+alt is required.
    #
    # Replace input_file with a real ROOT file; the fcl is structurally valid
    # even if the file is missing, the provider will then [SKIP] with
    # "missing external data file".
    FSIReweight_input_manifest: {
      input_file: "${NUSYST_DATA_DIR}/FSI/FSI_Evis_reweight_template.root"
      inputs: [
        { input_hist: "hA2018_protonPlus_KEini_vs_Ebias"     name: "hist_nom_protonPlus"},
        { input_hist: "Geant4_protonPlus_KEini_vs_Ebias"     name: "hist_alt_protonPlus"},
        { input_hist: "hA2018_neutron_KEini_vs_Ebias"        name: "hist_nom_neutron"},
        { input_hist: "Geant4_neutron_KEini_vs_Ebias"        name: "hist_alt_neutron"},
        { input_hist: "hA2018_piPlus_KEini_vs_Ebias"         name: "hist_nom_piPlus"},
        { input_hist: "Geant4_piPlus_KEini_vs_Ebias"         name: "hist_alt_piPlus"},
        { input_hist: "hA2018_pi0_KEini_vs_Ebias"            name: "hist_nom_pi0"},
        { input_hist: "Geant4_pi0_KEini_vs_Ebias"            name: "hist_alt_pi0"},
        { input_hist: "hA2018_piMinus_KEini_vs_Ebias"        name: "hist_nom_piMinus"},
        { input_hist: "Geant4_piMinus_KEini_vs_Ebias"        name: "hist_alt_piMinus"}
      ]
    }
    
  }

syst_providers: [FSI_Ebias_G4BC_Tool_Config]
