SuSAv2ToValenica_MECInterp_q0binned_all: {

  tool_type: "MECq0q3InterpWeighting"
  instance_name: "SuSAv2ToValenica_q0binned_all"

  # One shared set of q0 dials. The provider selects the numu, numubar, nue,
  # or nuebar response maps from the incoming probe PDG for each event.
  MECResponse_q0bin0_central_value: 0
  MECResponse_q0bin0_variation_descriptor: "[1]"

  MECResponse_q0bin1_central_value: 0
  MECResponse_q0bin1_variation_descriptor: "[1]"

  MECResponse_q0bin2_central_value: 0
  MECResponse_q0bin2_variation_descriptor: "[1]"

  MECResponse_q0bin3_central_value: 0
  MECResponse_q0bin3_variation_descriptor: "[1]"

  MECResponse_input_manifest: {
    Model: "valencia"

    # Flavors share the four dial IDs above but retain separate map grids.
    Flavors: ["numu", "numubar", "nue", "nuebar"]
    NuisFlatWeightMapBaseDir: "/exp/icarus/app/users/hassinin/karim_nusystematics/nusystematics/weight_test_folders_all_flavors"

    Q0Bins: [0.0, 0.2, 0.4, 0.6, 10.0]

    # numu, nue, and nuebar maps cover 0.20--3.00 GeV.
    EnergyGrid: [
      0.20, 0.25, 0.30, 0.35, 0.40, 0.45, 0.50, 0.55, 0.60, 0.65,
      0.70, 0.75, 0.80, 0.85, 0.90, 0.95, 1.00, 1.05, 1.10, 1.15,
      1.20, 1.25, 1.30, 1.35, 1.40, 1.45, 1.50, 1.55, 1.60, 1.65,
      1.70, 1.75, 1.80, 1.85, 1.90, 1.95, 2.00, 2.05, 2.10, 2.15,
      2.20, 2.25, 2.30, 2.35, 2.40, 2.45, 2.50, 2.55, 2.60, 2.65,
      2.70, 2.75, 2.80, 2.85, 2.90, 2.95, 3.00
    ]

    # Valencia numubar maps start at 0.25 GeV. EnuMin is clamped to the first
    # entry of the selected flavor grid at runtime.
    EnergyGrids: {
      numubar: [
        0.25, 0.30, 0.35, 0.40, 0.45, 0.50, 0.55, 0.60, 0.65, 0.70,
        0.75, 0.80, 0.85, 0.90, 0.95, 1.00, 1.05, 1.10, 1.15, 1.20,
        1.25, 1.30, 1.35, 1.40, 1.45, 1.50, 1.55, 1.60, 1.65, 1.70,
        1.75, 1.80, 1.85, 1.90, 1.95, 2.00, 2.05, 2.10, 2.15, 2.20,
        2.25, 2.30, 2.35, 2.40, 2.45, 2.50, 2.55, 2.60, 2.65, 2.70,
        2.75, 2.80, 2.85, 2.90, 2.95, 3.00
      ]
    }

    WeightLimits: [0.1, 1000.0]
    Q0ApplyMin: 0.0
    Q0ApplyMax: 1.2
    Q3ApplyMin: 0.0
    Q3ApplyMax: 1.2

    EnuMin: 0.20
    EnuMax: 3.0
    EnuSnapTol: 0.005

    HistNameNP: "h_weights_map;1"
    HistNameNN: "h_weights_map;1"
    MapIsQ3xQ0: true
    UseNearestBin: false
    EdgeClamp: true
    OutOfRangeWeight: 0.0
  }
}

syst_providers: [SuSAv2ToValenica_MECInterp_q0binned_all]
