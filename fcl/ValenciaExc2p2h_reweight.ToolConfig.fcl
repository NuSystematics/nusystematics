  # path to bdt reweighter json object pp and pn out-going state events
  JSON_PP_REWEIGHTER_PATH: "/exp/icarus/data/users/zihaolin/MC_outputs/bdtreweighters_json/ICARUS_BNB_numu_C12_SuSAv2_to_ValenciaExclusive_2p2h_pn_bdtreweighter.json"
  JSON_PN_REWEIGHTER_PATH: "/exp/icarus/data/users/zihaolin/MC_outputs/bdtreweighters_json/ICARUS_BNB_numu_C12_SuSAv2_to_ValenciaExclusive_2p2h_pn_bdtreweighter.json"
  # Note: the BDT reweighers are trained and saved to json using python module BDTReweight

